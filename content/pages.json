[{"id":2,"date":"2023-08-20T19:41:42","date_gmt":"2023-08-20T19:41:42","guid":{"rendered":"https:\/\/www.rezab.eu\/?page_id=2"},"modified":"2023-08-25T21:34:22","modified_gmt":"2023-08-25T19:34:22","slug":"about","status":"publish","type":"page","link":"https:\/\/www.rezab.eu\/about\/","title":{"rendered":"About"},"content":{"rendered":"\n<div class=\"wp-block-columns is-layout-flex wp-container-core-columns-is-layout-f56f613f wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-content-justification-left is-layout-constrained wp-container-core-column-is-layout-69d0b17a wp-block-column-is-layout-constrained\" style=\"flex-basis:220px\">\n<figure class=\"wp-block-image size-full is-resized has-custom-border is-style-rounded wp-container-content-e0b89f81 wp-duotone-unset-1\"><img decoding=\"async\" src=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/me.jpg\" alt=\"\" class=\"wp-image-73\" style=\"border-style:none;border-width:0px;border-radius:100px;object-fit:cover;width:191px;height:191px\" width=\"191\" height=\"191\" srcset=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/me.jpg 680w, https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/me-300x300.jpg 300w, https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/me-150x150.jpg 150w\" sizes=\"(max-width: 191px) 100vw, 191px\" \/><\/figure>\n<\/div>\n\n\n\n<div class=\"wp-block-column is-vertically-aligned-center is-content-justification-left is-layout-constrained wp-container-core-column-is-layout-69d0b17a wp-block-column-is-layout-constrained\">\n<p class=\"wp-block-paragraph\">My name is Jan \u0158e\u017eab (very hard to pronounce for a English native, I know \ud83d\ude09). I live in Prague, Czech Republic and I&#8217;m proud father, Microsoft 365 Consultant, tech geek, enthusiast to Modern Endpoint Management and biker.<\/p>\n<\/div>\n<\/div>\n\n\n\n<h2 class=\"wp-block-heading has-large-font-size\"><strong>Experience<\/strong><\/h2>\n\n\n\n<p class=\"wp-block-paragraph\">I have been working in IT for more than 25 years. For the last few years I have been focusing mainly on Microsoft Intune, MECM, Defender, etc\u2026<\/p>\n\n\n\n<p class=\"wp-block-paragraph\">I currently work for <a href=\"https:\/\/www.seyfor.com\" target=\"_blank\" rel=\"noreferrer noopener\">Seyfor, a.s.<\/a>. My colleagues and I provide professional consulting services in Microsoft 365 and cloud infrastructure.<\/p>\n\n\n\n<h2 class=\"wp-block-heading has-large-font-size\"><strong>Certification<\/strong><\/h2>\n\n\n\n<figure class=\"wp-block-gallery has-nested-images columns-default is-cropped wp-block-gallery-2 is-layout-flex wp-block-gallery-is-layout-flex\">\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"600\" height=\"600\" data-id=\"82\" src=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-enterprise-adminstrator-expert-600x600-1.png\" alt=\"Microsoft 365 Certified: Enterprise Administrator\" class=\"wp-image-82\" srcset=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-enterprise-adminstrator-expert-600x600-1.png 600w, https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-enterprise-adminstrator-expert-600x600-1-300x300.png 300w, https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-enterprise-adminstrator-expert-600x600-1-150x150.png 150w\" sizes=\"(max-width: 600px) 100vw, 600px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" width=\"600\" height=\"600\" data-id=\"83\" src=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-modern-desktop-administrator-associate-600x600-1.png\" alt=\"\" class=\"wp-image-83\" srcset=\"https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-modern-desktop-administrator-associate-600x600-1.png 600w, https:\/\/www.rezab.eu\/wp-content\/uploads\/2023\/08\/microsoft365-modern-desktop-administrator-associate-600x600-1-300x300.png 300w, https:\/\/www.rezab.eu\/wp-co